#. Plugin Name of the plugin
msgid "Alyxa Accessibility"
msgstr "Alyxa Dostępność"

#. Description of the plugin
msgid "Accessibility panel built on the active theme's own design tokens. Every feature is a module that can be switched off site by site, and a module that is off leaves no button, no CSS rule and no listener behind."
msgstr "Panel dostępności zbudowany na tokenach graficznych aktywnego motywu. Każda funkcja jest modułem, który można wyłączyć osobno na każdej stronie, a moduł wyłączony nie zostawia po sobie ani przycisku, ani reguły CSS, ani nasłuchu zdarzeń."

#: inc/konfiguracja.php
msgid "Bottom left"
msgstr "Lewy dolny"

#: inc/konfiguracja.php
msgid "Bottom right"
msgstr "Prawy dolny"

#: inc/konfiguracja.php
msgid "Top left"
msgstr "Lewy górny"

#: inc/konfiguracja.php
msgid "Top right"
msgstr "Prawy górny"

#: inc/panel.php
msgid "Accessibility settings"
msgstr "Ustawienia dostępności"

#: inc/panel.php
msgid "Close accessibility settings"
msgstr "Zamknij ustawienia dostępności"

#: inc/panel.php
msgid "No accessibility features are switched on for this site yet."
msgstr "Na tej stronie nie włączono jeszcze żadnych ułatwień."

#: inc/panel.php
msgid "Reset all settings"
msgstr "Przywróć ustawienia domyślne"

#: inc/panel.php
msgid "Your choices stay in this browser. Nothing is sent to the server."
msgstr "Twoje ustawienia zostają w tej przeglądarce. Nic nie jest wysyłane na serwer."

#. translators: 1: current level, 2: number of levels.
#: inc/zasoby.php
msgid "level %1$d of %2$d"
msgstr "poziom %1$d z %2$d"

#: inc/zasoby.php
msgid "off"
msgstr "wyłączone"

#: inc/moduly.php
msgid "More text spacing"
msgstr "Większe odstępy w tekście"

#: inc/moduly.php
msgid "Taller lines, wider gaps between letters, words and paragraphs."
msgstr "Wyższe wiersze, większe odstępy między literami, słowami i akapitami."

#: inc/moduly.php
msgid "Underline links"
msgstr "Podkreślenie odnośników"

#: inc/moduly.php
msgid "Every link gets an underline, so it stands out from ordinary text."
msgstr "Każdy odnośnik dostaje podkreślenie i odróżnia się od zwykłego tekstu."

#: inc/moduly.php
msgid "Stop animations"
msgstr "Zatrzymanie animacji"

#: inc/moduly.php
msgid "Turns off movement, sliding and fading across the page."
msgstr "Wyłącza ruch, przesuwanie i przenikanie na stronie."

#: inc/moduly.php
msgid "Larger text"
msgstr "Większy tekst"

#: inc/moduly.php
msgid "Makes every text on the page bigger, in three steps up to 150%."
msgstr "Powiększa cały tekst na stronie, w trzech stopniach do 150%."

#: inc/moduly.php
msgid "High contrast"
msgstr "Wysoki kontrast"

#: inc/moduly.php
msgid "Black background, white text, yellow links. Photographs stay."
msgstr "Czarne tło, biały tekst, żółte odnośniki. Zdjęcia zostają."

#: inc/moduly.php
msgid "Dyslexia-friendly font"
msgstr "Czcionka dla osób z dysleksją"

#: inc/moduly.php
msgid "Atkinson Hyperlegible, a typeface drawn so that similar letters cannot be confused."
msgstr "Atkinson Hyperlegible — krój pisma narysowany tak, żeby podobnych liter nie dało się pomylić."

#: inc/moduly.php
msgid "Large cursor"
msgstr "Duży kursor"

#: inc/moduly.php
msgid "A bigger mouse pointer, white with a black outline so it shows on any background."
msgstr "Większy wskaźnik myszy, biały z czarnym obrysem, więc widać go na każdym tle."

#: inc/moduly.php
msgid "Reading mask"
msgstr "Maska czytania"

#: inc/moduly.php
msgid "Dims the page except for a band that follows the pointer, so the eye keeps its line."
msgstr "Przyciemnia stronę poza pasmem, które idzie za wskaźnikiem — wzrok nie ucieka do sąsiednich wierszy."

#: inc/moduly.php
msgid "Read what you click"
msgstr "Czytaj wskazane"

#: inc/moduly.php
msgid "Reads one thing at a time: the paragraph, heading or link you click, or the one you reach with the Tab key."
msgstr "Czyta pojedynczy fragment: akapit, nagłówek albo odnośnik, który klikniesz albo na który wejdziesz tabulatorem."

#: inc/moduly.php
msgid "Read aloud"
msgstr "Czytanie na głos"

#: inc/moduly.php
msgid "Reads the main content with a voice installed on your own device. Reading stops when you leave the page."
msgstr "Czyta główną treść strony głosem zainstalowanym na Twoim urządzeniu. Czytanie kończy się, gdy opuścisz stronę."

#: inc/moduly.php
msgid "Read the page"
msgstr "Czytaj stronę"

#: inc/moduly.php
msgid "Stop reading"
msgstr "Zatrzymaj czytanie"

#: inc/moduly.php
msgid "Pause reading"
msgstr "Wstrzymaj czytanie"

#: inc/moduly.php
msgid "Resume reading"
msgstr "Wznów czytanie"

#: inc/moduly.php
msgid "Reading the page"
msgstr "Trwa czytanie strony"

#: inc/moduly.php
msgid "Reading paused"
msgstr "Czytanie wstrzymane"

#: inc/moduly.php
msgid "There is no text to read on this page."
msgstr "Na tej stronie nie ma tekstu do przeczytania."

#: inc/panel.php
msgid "Decrease"
msgstr "Zmniejsz"

#: inc/panel.php
msgid "Increase"
msgstr "Powiększ"

#: inc/rejestr.php
msgid "Text and reading"
msgstr "Tekst i czytanie"

#: inc/rejestr.php
msgid "Colour and contrast"
msgstr "Kolor i kontrast"

#: inc/rejestr.php
msgid "Pointer and reading guides"
msgstr "Wskaźnik i prowadnice"

#: inc/rejestr.php
msgid "Speech"
msgstr "Mowa"

#: inc/ustawienia.php
msgid "Reading aloud"
msgstr "Czytanie na głos"

#: inc/konfiguracja.php
msgid "Minimal"
msgstr "Minimalny"

#: inc/konfiguracja.php
msgid "Larger text, spacing and high contrast. The three that help the most people, and the three that cannot surprise anyone."
msgstr "Większy tekst, odstępy i wysoki kontrast. Trzy, które pomagają największej liczbie osób, i trzy, które nikogo nie zaskoczą."

#: inc/konfiguracja.php
msgid "Public institution"
msgstr "Placówka publiczna"

#: inc/konfiguracja.php
msgid "Everything this plugin ships as standard. This is what a new installation starts with."
msgstr "Wszystko, co wtyczka ma w standardzie. Od tego zaczyna nowa instalacja."

#: inc/konfiguracja.php
msgid "Everything"
msgstr "Wszystko"

#: inc/konfiguracja.php
msgid "Every module in the register, including any added by your theme or another plugin."
msgstr "Każdy moduł w rejestrze, razem z tymi, które dokłada motyw albo inna wtyczka."

#: inc/ustawienia.php
msgid "Accessibility"
msgstr "Dostępność"

#: inc/ustawienia.php
msgid "Settings"
msgstr "Ustawienia"

#: inc/ustawienia.php
msgid "You are not allowed to change accessibility settings on this site."
msgstr "Nie masz uprawnień do zmiany ustawień dostępności na tej stronie."

#: inc/ustawienia.php
msgid "These settings decide what the panel offers on this site. What a visitor then switches on for themselves is kept in their own browser and never reaches the server."
msgstr "Te ustawienia decydują o tym, co panel oferuje na tej stronie. To, co odwiedzający sobie potem włączy, zostaje w jego własnej przeglądarce i nigdy nie trafia na serwer."

#: inc/ustawienia.php
msgid "Save settings"
msgstr "Zapisz ustawienia"

#: inc/ustawienia.php
msgid "Settings saved, with the modules from the \"%s\" set."
msgstr "Ustawienia zapisane, z modułami z zestawu „%s”."

#: inc/ustawienia.php
msgid "Settings saved."
msgstr "Ustawienia zapisane."

#: inc/ustawienia.php
msgid "Modules"
msgstr "Moduły"

#: inc/ustawienia.php
msgid "A module that is off leaves nothing behind: no tile in the panel, no CSS rule, no event listener. It is not hidden - it is not on the page."
msgstr "Moduł wyłączony nie zostawia po sobie niczego: ani kafelka w panelu, ani reguły CSS, ani nasłuchu zdarzeń. Nie jest ukryty — nie ma go na stronie."

#: inc/ustawienia.php
msgid "No modules are registered. Something has removed them with the alyxa_moduly filter."
msgstr "W rejestrze nie ma żadnego modułu. Coś usunęło je filtrem alyxa_moduly."

#: inc/ustawienia.php
msgid "Other modules"
msgstr "Pozostałe moduły"

#: inc/ustawienia.php
msgid "The button"
msgstr "Przycisk"

#: inc/ustawienia.php
msgid "Corner"
msgstr "Róg ekranu"

#: inc/ustawienia.php
msgid "The bottom right corner is usually taken already - by a back-to-top button, a chat bubble or a consent banner. Two round buttons on top of each other are two touch targets eating one another."
msgstr "Prawy dolny róg jest zwykle już zajęty — przez przycisk powrotu na górę, okienko czatu albo baner zgód. Dwa okrągłe przyciski jeden na drugim to dwa cele dotykowe, które się zjadają."

#: inc/ustawienia.php
msgid "Distance from the edge"
msgstr "Odstęp od krawędzi"

#: inc/ustawienia.php
msgid "px"
msgstr "px"

#: inc/ustawienia.php
msgid "Between 8 and 64. Below that the button sticks to the edge of the screen; above it, it floats in the middle of nothing."
msgstr "Od 8 do 64. Poniżej przycisk klei się do krawędzi ekranu, powyżej — wisi w powietrzu."

#: inc/ustawienia.php
msgid "Accent colour"
msgstr "Kolor akcentu"

#: inc/ustawienia.php
msgid "Leave this empty and the panel takes its colours from the theme, which is what it is built to do. Fill it in only when the theme publishes no palette, or when the panel has to stand out against it."
msgstr "Zostaw puste, a panel weźmie kolory z motywu — i po to został zbudowany. Wpisz coś tylko wtedy, gdy motyw nie publikuje palety albo gdy panel ma się na jego tle wyróżniać."

#: inc/ustawienia.php
msgid "What counts as the content"
msgstr "Co jest treścią strony"

#: inc/ustawienia.php
msgid "CSS selectors separated by commas, tried one after another - the first one that matches anything wins. This is where \"Read the page\" starts from, so it should be the article, not the whole document: a menu and a footer read out loud are half a minute after which nobody knows what the page was about."
msgstr "Selektory CSS oddzielone przecinkami, próbowane po kolei — wygrywa pierwszy, który cokolwiek znajdzie. Stąd zaczyna „Czytaj stronę”, więc ma to być artykuł, a nie cały dokument: menu i stopka przeczytane na głos to pół minuty, po których nie wiadomo, o czym była strona."

#: inc/ustawienia.php
msgid "Leave it empty to use the built-in list: %s"
msgstr "Zostaw puste, żeby użyć listy wbudowanej: %s"

#: inc/ustawienia.php
msgid "Starter sets"
msgstr "Zestawy startowe"

#: inc/ustawienia.php
msgid "A set switches every module at once, so it also switches off the ones it does not include. Use it as a starting point and correct it above."
msgstr "Zestaw przestawia wszystkie moduły naraz, więc wyłącza także te, których nie obejmuje. Potraktuj go jako punkt wyjścia i popraw wyżej."

#: inc/ustawienia.php
msgid "Status"
msgstr "Stan"

#: inc/ustawienia.php
msgid "Modules on"
msgstr "Włączone moduły"

#: inc/ustawienia.php
msgid "None. The panel will tell visitors there is nothing to switch on."
msgstr "Żadne. Panel powie odwiedzającym, że nie ma czego włączać."

#: inc/ustawienia.php
msgid "Module stylesheet"
msgstr "Arkusz modułów"

#: inc/ustawienia.php
msgid "Written into the page itself, because the uploads folder is not writable. Everything works; the rules just cannot be cached by the browser."
msgstr "Wpisany wprost do strony, bo katalog wysyłanych plików nie jest zapisywalny. Wszystko działa, tylko przeglądarka nie odłoży reguł do pamięci podręcznej."

#: inc/ustawienia.php
msgid "Empty - none of the modules that are on brings any CSS with it."
msgstr "Pusty — żaden z włączonych modułów nie wnosi własnego CSS."

#: inc/ustawienia.php
msgid "Visitor settings"
msgstr "Ustawienia odwiedzających"

#: inc/ustawienia.php
msgid "Kept in each visitor's own browser. The plugin sets no cookies, stores no personal data and needs no consent banner."
msgstr "Trzymane w przeglądarce każdego odwiedzającego. Wtyczka nie ustawia ciasteczek, nie przechowuje danych osobowych i nie potrzebuje banera zgód."

#: inc/rejestr.php
msgid "Fewer distractions"
msgstr "Mniej rozpraszania"

#: inc/rejestr.php
msgid "Help"
msgstr "Pomoc"

#: inc/panel.php
msgid "Other"
msgstr "Pozostałe"

#: inc/katalog.php
msgid "Align text left"
msgstr "Wyrównanie do lewej"

#: inc/katalog.php
msgid "Every line starts in the same place, the spacing between words stops stretching and no word is broken at the end of a line."
msgstr "Każdy wiersz zaczyna się w tym samym miejscu, odstępy między słowami przestają się rozciągać, a żaden wyraz nie jest dzielony na końcu wiersza."

#: inc/katalog.php
msgid "Bolder text"
msgstr "Grubsze pismo"

#: inc/katalog.php
msgid "Thickens ordinary text. Headings and words already in bold are left alone, because a fixed weight could make them lighter than they are."
msgstr "Pogrubia tekst ciągły. Nagłówki i wyrazy już pogrubione zostają bez zmian, bo narzucona grubość mogłaby je ścienić."

#: inc/katalog.php
msgid "Dark mode"
msgstr "Ciemny tryb"

#: inc/katalog.php
msgid "A dark page with light text, for reading in the evening or with light sensitivity. High contrast wins over it when both are on."
msgstr "Ciemna strona z jasnym tekstem, do czytania wieczorem albo przy nadwrażliwości na światło. Przy włączonym wysokim kontraście wygrywa kontrast."

#: inc/katalog.php
msgid "Fewer colours"
msgstr "Mniej barw"

#: inc/katalog.php
msgid "Weakens the colours of the page, down to grey. A warning: two colours that differ only in hue become the same shade, so anything told by colour alone stops being visible."
msgstr "Osłabia barwy strony, aż do szarości. Uwaga: dwie barwy różniące się wyłącznie odcieniem stają się tym samym szarym, więc wszystko, co strona mówi samym kolorem, przestaje być widoczne."

#: inc/katalog.php
msgid "Hide pictures"
msgstr "Ukryj obrazy"

#: inc/katalog.php
msgid "Photographs and graphics become invisible, leaving their space and their description behind. A warning: a timetable or a notice published as a picture disappears with them."
msgstr "Zdjęcia i grafiki stają się niewidoczne, zostawiając swoje miejsce i swój opis. Uwaga: plan lekcji albo ogłoszenie wystawione jako obrazek znika razem z nimi."

#: inc/katalog.php
msgid "Mute sound"
msgstr "Wycisz dźwięki"

#: inc/katalog.php
msgid "Silences recordings on this page, including the ones that start playing later. A player embedded from another site cannot be silenced from here."
msgstr "Wycisza nagrania na tej stronie, także te, które ruszą później. Odtwarzacza osadzonego z innej strony nie da się stąd wyciszyć."

#: inc/katalog.php
msgid "Reading line"
msgstr "Linia czytania"

#: inc/katalog.php
msgid "A line that follows the pointer and the keyboard focus, so the eye keeps its place in a long text. Lighter than the reading mask, which dims everything else."
msgstr "Kreska idąca za wskaźnikiem i za fokusem klawiatury, żeby wzrok nie gubił wiersza w długim tekście. Lżejsza od maski czytania, która przyciemnia całą resztę."

#: inc/katalog.php
msgid "Keyboard shortcuts"
msgstr "Skróty klawiszowe"

#: inc/katalog.php
msgid "Switches the other modules with Alt+Shift and the letter shown in the corner of each tile. Alt+Shift+A opens and closes this panel. Shortcuts are ignored while you are typing in a field."
msgstr "Przełącza pozostałe moduły kombinacją Alt+Shift i litery pokazanej w rogu kafelka. Alt+Shift+A otwiera i zamyka ten panel. W polu tekstowym skróty milczą."

#: inc/katalog.php
msgid "%s: on"
msgstr "%s: włączone"

#: inc/katalog.php
msgid "%s: off"
msgstr "%s: wyłączone"

#: inc/katalog.php
msgid "%1$s: %2$s"
msgstr "%1$s: %2$s"

#: inc/katalog.php
msgid "Accessibility statement"
msgstr "Deklaracja dostępności"

#: inc/katalog.php
msgid "Opens the page where this institution says how accessible its site is and who to write to about it."
msgstr "Otwiera stronę, na której placówka mówi, jak dostępny jest jej serwis i do kogo pisać w tej sprawie."

#: inc/ustawienia.php
msgid "Address of the statement"
msgstr "Adres deklaracji"

#: inc/ustawienia.php
msgid "The panel shows a link to this page. Every public institution in Poland has to publish such a statement and keep it reachable from the home page; the accessibility panel is where people look for it."
msgstr "Panel pokazuje odnośnik do tej strony. Każda placówka publiczna w Polsce ma taką deklarację opublikować i utrzymywać osiągalną ze strony głównej, a panel dostępności jest miejscem, w którym ludzie jej szukają."

#: inc/ustawienia.php
msgid "The module is on and this field is empty, so the panel shows nothing at all. Fill in the address or switch the module off."
msgstr "Moduł jest włączony, a to pole jest puste, więc panel nie pokazuje nic. Wpisz adres albo wyłącz moduł."

#: inc/ustawienia.php
msgid "The accessibility panel keeps the visitor's choices in their own browser and sends nothing to the server. Paste the paragraph below into your privacy policy if you list browser storage there."
msgstr "Panel dostępności trzyma wybory odwiedzającego w jego własnej przeglądarce i nie wysyła niczego na serwer. Jeśli wymieniasz w polityce prywatności dane trzymane w przeglądarce, wklej do niej akapit poniżej."

#: inc/ustawienia.php
msgid "Suggested text:"
msgstr "Proponowana treść:"

#: inc/ustawienia.php
msgid "This site offers an accessibility panel: larger text, higher contrast, a reading mask and similar aids. Whatever you switch on there is remembered in your own browser, in what is called local storage, so that the site looks the same on your next visit. That record stays on your device. It is not a cookie, it is never sent to us, we cannot read it and it is not shared with anyone. Clearing your browsing data for this site removes it. If you use the read-aloud feature, the speech is produced by your own device or operating system; the text being read does not leave your browser through this plugin."
msgstr "Ta strona oferuje panel dostępności: większy tekst, wyższy kontrast, pasmo ułatwiające czytanie i podobne udogodnienia. To, co w nim włączysz, zapamiętuje Twoja własna przeglądarka — w pamięci lokalnej. Ten zapis zostaje na Twoim urządzeniu. Nie jest ciasteczkiem, nie trafia do nas, nie umiemy go odczytać i nie jest nikomu udostępniany. Wyczyszczenie danych przeglądania dla tej strony usuwa go. Jeśli korzystasz z czytania na głos, mowę wytwarza Twoje własne urządzenie lub system; czytany tekst nie opuszcza przez tę wtyczkę Twojej przeglądarki."

#: inc/katalog.php
msgid "Text alignment"
msgstr "Wyrównanie tekstu"

#: inc/katalog.php
msgid "Three settings, one after another: every line starting in the same place, every line centred, every line ending in the same place. Justified text stops stretching the spaces between words and no word is broken at the end of a line."
msgstr "Trzy ustawienia, jedno po drugim: każdy wiersz zaczyna się w tym samym miejscu, każdy wiersz wyśrodkowany, każdy wiersz kończy się w tym samym miejscu. Tekst wyjustowany przestaje rozciągać odstępy między słowami, a żaden wyraz nie jest dzielony na końcu wiersza."

#: inc/katalog.php
msgid "As the page has it"
msgstr "Tak jak na stronie"

#: inc/katalog.php
msgid "Line start"
msgstr "Do początku wiersza"

#: inc/katalog.php
msgid "Centred"
msgstr "Do środka"

#: inc/katalog.php
msgid "Line end"
msgstr "Do końca wiersza"

#: inc/katalog.php
msgid "Centred text and text aligned to the line end are harder to read in long passages. The first setting, line start, is the one that helps."
msgstr "Tekst wyśrodkowany i dosunięty do końca wiersza czyta się trudniej w dłuższych fragmentach. Pomaga pierwsze ustawienie, do początku wiersza."

#: inc/katalog.php
msgid "Anything the page says with colour alone stops being visible."
msgstr "Wszystko, co strona przekazuje samym kolorem, przestaje być widoczne."

#: inc/katalog.php
msgid "A picture that carries text or information disappears together with the others."
msgstr "Obraz, który niesie tekst albo informację, znika razem z pozostałymi."

#: inc/katalog.php
msgid "Your own colours"
msgstr "Własne kolory"

#: inc/katalog.php
msgid "Choose the colour of text, background and links, or start from a ready palette. The panel shows the contrast of your choice while you make it. Your colours win over high contrast and dark mode."
msgstr "Wybierz kolor tekstu, tła i odnośników albo zacznij od gotowej palety. Panel pokazuje kontrast Twojego wyboru na bieżąco. Własne kolory mają pierwszeństwo przed wysokim kontrastem i ciemnym trybem."

#: inc/katalog.php
msgid "Text"
msgstr "Tekst"

#: inc/katalog.php
msgid "Background"
msgstr "Tło"

#: inc/katalog.php
msgid "Links"
msgstr "Odnośniki"

#: inc/katalog.php
msgid "Black on cream"
msgstr "Czarny na kremowym"

#: inc/katalog.php
msgid "Yellow on black"
msgstr "Żółty na czarnym"

#: inc/katalog.php
msgid "White on navy"
msgstr "Biały na granatowym"

#: inc/katalog.php
msgid "Brown on beige"
msgstr "Brązowy na beżowym"

#: inc/katalog.php
msgid "Invert colours"
msgstr "Odwrócenie kolorów"

#: inc/katalog.php
msgid "Turns light into dark and dark into light across the whole page. Photographs and videos are turned back, so people keep their natural colours."
msgstr "Zamienia jasne na ciemne i ciemne na jasne na całej stronie. Zdjęcia i nagrania są odwracane z powrotem, więc ludzie zachowują naturalne kolory."

#: inc/katalog.php
msgid "Colours swap their meaning - red turns cyan and green turns pink - and drawings and icons stay inverted."
msgstr "Kolory zmieniają znaczenie – czerwony staje się turkusowy, a zielony różowy – a rysunki i ikony zostają odwrócone."

#: inc/katalog.php
msgid "Colour blindness filter"
msgstr "Filtr dla daltonistów"

#: inc/katalog.php
msgid "Shifts the colours of the page so that pairs easy to confuse with a given type of colour blindness move further apart. One setting for each of the three types."
msgstr "Przesuwa kolory strony tak, żeby pary łatwe do pomylenia przy danym rodzaju daltonizmu bardziej się od siebie różniły. Osobne ustawienie dla każdego z trzech rodzajów."

#: inc/katalog.php
msgid "Red (protanopia)"
msgstr "Czerwień (protanopia)"

#: inc/katalog.php
msgid "Green (deuteranopia)"
msgstr "Zieleń (deuteranopia)"

#: inc/katalog.php
msgid "Blue (tritanopia)"
msgstr "Błękit (tritanopia)"

#: inc/katalog.php
msgid "The filter moves every colour on the page, including those that were already easy to tell apart, and some people find the result harder to read, not easier."
msgstr "Filtr przesuwa każdy kolor na stronie, także te, które dało się łatwo odróżnić, i części osób czyta się z nim trudniej, a nie łatwiej."

#: inc/katalog.php
msgid "Colour overlay"
msgstr "Nakładka barwna"

#: inc/katalog.php
msgid "Lays a light tint over the whole page, the way a coloured reading sheet lies over a book. Four tints, one after another."
msgstr "Kładzie na całą stronę lekki odcień, tak jak kolorowa folia do czytania leży na książce. Cztery odcienie, jeden po drugim."

#: inc/katalog.php
msgid "Yellow"
msgstr "Żółta"

#: inc/katalog.php
msgid "Blue"
msgstr "Niebieska"

#: inc/katalog.php
msgid "Green"
msgstr "Zielona"

#: inc/katalog.php
msgid "Pink"
msgstr "Różowa"

#: inc/katalog.php
msgid "A tint lowers the contrast of the whole page. Research has not shown that coloured overlays help with dyslexia; they are here because some people find them more comfortable."
msgstr "Odcień obniża kontrast całej strony. Badania nie wykazały, że kolorowe nakładki pomagają przy dysleksji; są tu, bo części osób czyta się z nimi wygodniej."

#: inc/katalog.php
msgid "Dim the page"
msgstr "Przyciemnienie"

#: inc/katalog.php
msgid "Darkens the whole page in three steps, for reading in a dark room or with light sensitivity. Unlike dark mode, it keeps the page's own colours."
msgstr "Przyciemnia całą stronę w trzech stopniach, do czytania w ciemnym pokoju albo przy nadwrażliwości na światło. W odróżnieniu od ciemnego trybu zachowuje kolory strony."

#: inc/katalog.php
msgid "Dimming lowers the contrast of the whole page; at the darkest step grey text can fall below the WCAG minimum."
msgstr "Przyciemnienie obniża kontrast całej strony; przy najciemniejszym stopniu szary tekst może spaść poniżej minimum WCAG."

#: inc/panel.php
#, php-format
msgid "Warning (WCAG %1$s): %2$s"
msgstr "Ostrzeżenie (WCAG %1$s): %2$s"

#: inc/panel.php
msgid "Why some tiles carry a warning sign"
msgstr "Dlaczego niektóre kafelki mają znak ostrzegawczy"

#: inc/panel.php
msgid "These settings go beyond the WCAG guidelines and can make part of the page harder to read. They are here because some people find them helpful."
msgstr "Te ustawienia wykraczają poza wytyczne WCAG i mogą utrudnić odbiór części strony. Są tu, bo części osób pomagają."

#: inc/panel.php
#, php-format
msgid "(WCAG %s):"
msgstr "(WCAG %s):"

#: inc/panel.php
#, php-format
msgid "Switch off: %s"
msgstr "Wyłącz: %s"

#: inc/ustawienia.php
msgid "Each module says how it relates to WCAG. Supports: it meets the success criterion named on it. Outside WCAG: the guidelines do not cover it, and it makes nothing worse. Risk: it can make something WCAG measures worse - the reason is written next to it, and visitors see a warning sign on its tile."
msgstr "Każdy moduł mówi, jak ma się do WCAG. Wspiera: spełnia kryterium podane przy nim. Poza WCAG: wytyczne go nie dotyczą i niczego nie pogarsza. Ryzyko: może pogorszyć coś, co WCAG mierzy – powód jest wypisany obok, a odwiedzający widzą znak ostrzegawczy na jego kafelku."

#: inc/ustawienia.php
#, php-format
msgid "Supports WCAG %s"
msgstr "Wspiera WCAG %s"

#: inc/ustawienia.php
msgid "Supports WCAG"
msgstr "Wspiera WCAG"

#: inc/ustawienia.php
#, php-format
msgid "Risk, WCAG %s:"
msgstr "Ryzyko, WCAG %s:"

#: inc/ustawienia.php
msgid "Risk:"
msgstr "Ryzyko:"

#: inc/ustawienia.php
msgid "Outside WCAG"
msgstr "Poza WCAG"

#: inc/zasoby.php
#, php-format
msgid "%1$s: contrast %2$s:1"
msgstr "%1$s: kontrast %2$s:1"

#: inc/zasoby.php
#, php-format
msgid "Below 4.5:1, the WCAG minimum for text: %s."
msgstr "Poniżej 4,5:1, minimum WCAG dla tekstu: %s."

#: inc/zasoby.php
msgid "Every pair reaches at least 4.5:1."
msgstr "Każda para ma co najmniej 4,5:1."
