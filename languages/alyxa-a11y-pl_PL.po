#. Plugin Name of the plugin
msgid "Alyxa Accessibility"
msgstr "Alyxa Dostępność"

#. Description of the plugin
msgid "Accessibility panel built on the active theme's own design tokens. Every feature is a module that can be switched off site by site, and a module that is off leaves no button, no CSS rule and no listener behind."
msgstr "Panel dostępności zbudowany na tokenach graficznych aktywnego motywu. Każda funkcja jest modułem, który można wyłączyć osobno na każdej stronie, a moduł wyłączony nie zostawia po sobie ani przycisku, ani reguły CSS, ani nasłuchu zdarzeń."

#: inc/konfiguracja.php
msgid "Bottom left"
msgstr "Lewy dolny"

#: inc/konfiguracja.php
msgid "Bottom right"
msgstr "Prawy dolny"

#: inc/konfiguracja.php
msgid "Top left"
msgstr "Lewy górny"

#: inc/konfiguracja.php
msgid "Top right"
msgstr "Prawy górny"

#: inc/panel.php
msgid "Accessibility settings"
msgstr "Ustawienia dostępności"

#: inc/panel.php
msgid "Close accessibility settings"
msgstr "Zamknij ustawienia dostępności"

#: inc/panel.php
msgid "No accessibility features are switched on for this site yet."
msgstr "Na tej stronie nie włączono jeszcze żadnych ułatwień."

#: inc/panel.php
msgid "Reset all settings"
msgstr "Przywróć ustawienia domyślne"

#: inc/panel.php
msgid "Your choices stay in this browser. Nothing is sent to the server."
msgstr "Twoje ustawienia zostają w tej przeglądarce. Nic nie jest wysyłane na serwer."

#. translators: 1: current level, 2: number of levels.
#: inc/zasoby.php
msgid "level %1$d of %2$d"
msgstr "poziom %1$d z %2$d"

#: inc/zasoby.php
msgid "off"
msgstr "wyłączone"

#: inc/moduly.php
msgid "More text spacing"
msgstr "Większe odstępy w tekście"

#: inc/moduly.php
msgid "Taller lines, wider gaps between letters, words and paragraphs."
msgstr "Wyższe wiersze, większe odstępy między literami, słowami i akapitami."

#: inc/moduly.php
msgid "Underline links"
msgstr "Podkreślenie odnośników"

#: inc/moduly.php
msgid "Every link gets an underline, so it stands out from ordinary text."
msgstr "Każdy odnośnik dostaje podkreślenie i odróżnia się od zwykłego tekstu."

#: inc/moduly.php
msgid "Stop animations"
msgstr "Zatrzymanie animacji"

#: inc/moduly.php
msgid "Turns off movement, sliding and fading across the page."
msgstr "Wyłącza ruch, przesuwanie i przenikanie na stronie."
